# Cloudflare static asset headers. Images and fonts rarely change, so browsers keep them for 30 days.
# CSS and JS keep their names when edited, so they are rechecked after an hour.
/img/*
  Cache-Control: public, max-age=2592000
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/assets/vendor/*
  Cache-Control: public, max-age=2592000
/assets/*.css
  Cache-Control: public, max-age=3600
/assets/*.js
  Cache-Control: public, max-age=3600
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

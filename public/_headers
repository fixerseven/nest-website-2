# Cloudflare static asset headers. When rules overlap, Cloudflare joins their values with a comma,
# so each specific rule detaches the catch-all Cache-Control ("! Cache-Control") before setting its own.

# Pages, the sitemap, robots.txt, llms.txt and the manifest: browsers recheck them on every visit,
# so a deploy shows up at once.
/*
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Photos and icons: kept for 7 days.
/img/*
  ! Cache-Control
  Cache-Control: public, max-age=604800
/favicon*
  ! Cache-Control
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  ! Cache-Control
  Cache-Control: public, max-age=604800

# Fonts and vendored scripts never change under the same name: kept for a year.
# Give an updated file a new name. The vendor rule comes after the *.js rule so it wins.
/assets/fonts/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# Our CSS and JS keep their names when edited, so they are rechecked after an hour.
/assets/*.css
  ! Cache-Control
  Cache-Control: public, max-age=3600
/assets/*.js
  ! Cache-Control
  Cache-Control: public, max-age=3600

# Vendored scripts: kept for a year, like the fonts above.
/assets/vendor/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# workers.dev and pull request preview URLs serve the same pages: keep them out of search results.
https://:version.:subdomain.workers.dev/*
  X-Robots-Tag: noindex
